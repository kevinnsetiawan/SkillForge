# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local PostgreSQL installed via winget (PostgreSQL 17).
# Adjust user/password if you changed them during setup.
DATABASE_URL="postgresql://postgres:skillforge_dev@localhost:5432/skillforge?schema=public"

# ---------------------------------------------------------------------------
# Auth.js / NextAuth v5
# ---------------------------------------------------------------------------
# Generate with:  npx auth secret
AUTH_SECRET="dev-only-insecure-secret-change-me-0123456789abcdef"
# Only needed if you deploy behind a proxy / on Vercel
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# GitHub OAuth (optional). Create an app at https://github.com/settings/developers
# with Homepage URL = http://localhost:3000 and Callback URL =
# http://localhost:3000/api/auth/callback/github
# Leave blank to hide the "Continue with GitHub" button.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# AI roadmap generator
# ---------------------------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint works. The AI tab on
# /roadmaps/new stays disabled with a friendly message until this is set.
#
# OpenAI:
#   AI_API_KEY="sk-..."
#   AI_BASE_URL="https://api.openai.com/v1"
#   AI_MODEL="gpt-4o-mini"
#
# Google Gemini (OpenAI-compatible endpoint):
#   AI_API_KEY="<gemini key>"
#   AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#   AI_MODEL="gemini-3.5-flash-lite"
#
# OpenRouter:
#   AI_API_KEY="sk-or-..."
#   AI_BASE_URL="https://openrouter.ai/api/v1"
#   AI_MODEL="openai/gpt-4o-mini"
#
# OPENAI_API_KEY and GEMINI_API_KEY are also picked up automatically when
# AI_API_KEY is empty.
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""
# Set to "false" only if your provider rejects response_format=json_object.
AI_JSON_MODE="true"
# Upper bound on generated tokens. Increase for very long roadmaps.
AI_MAX_TOKENS="3000"

# ---------------------------------------------------------------------------
# App behaviour
# ---------------------------------------------------------------------------
# IANA timezone used to decide which calendar day learning activity falls on.
# Streaks depend on this being correct for the learner.
APP_TIMEZONE="Asia/Jakarta"
